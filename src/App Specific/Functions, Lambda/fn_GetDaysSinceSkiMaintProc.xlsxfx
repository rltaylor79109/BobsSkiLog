=LAMBDA(
  pCurSeasonName,
  pDayIdx,
  pLastDaysVal,
  pLastDoneVal,
  pMaintSkiIdx,
  pMaintProcAbbrev,
  pRowSkiName,
  LET(
    _functionName,
    N(
      "fn_GetDaysSinceSkiMaintProc"
    ),
    _comment,
    N(
      "Gets the count of days since the specified maintenance procedure was performed on the specified ski."
    ),
    _SkiIdxPlusMainProcAbbrev,
    TEXT(
      pMaintSkiIdx,
      "0"
    ) & pMaintProcAbbrev,
    _priorSeasonName,
    fn_GetPriorSeasonName(
      pCurSeasonName
    ),
    _lastEOSdone,
    fn_GetEosSkiMaintDoneBySeasonAndProc(
      _priorSeasonName,
      _SkiIdxPlusMainProcAbbrev
    ),
    _lastEOSdays,
    fn_GetEosSkiMaintDaysBySeasonAndProc(
      _priorSeasonName,
      _SkiIdxPlusMainProcAbbrev
    ),
    pRowSkiIdx,
    fn_GetSkiIdxFromSkiName(
      pRowSkiName
    ),
    _rowAndProcSkiMatch,
    pRowSkiIdx = pMaintSkiIdx,
    _useLastSeasonVals,
    pDayIdx = 1,
    _done,
    IF(
      _useLastSeasonVals,
      _lastEOSdone,
      pLastDoneVal
    ),
    _prelimDays,
    IF(
      _useLastSeasonVals,
      _lastEOSdays,
      pLastDaysVal
    ),
    _addForCurDaySkiMatch,
    IF(
      _rowAndProcSkiMatch,
      1,
      0
    ),
    _result,
    IF(
      _done,
      _addForCurDaySkiMatch,
      _prelimDays + _addForCurDaySkiMatch
    ),
    _result
  )
)
=LAMBDA(
  pSeasonName,
  LET(
    _functionName,
    N(
      "fn_GetTblDaysColResortNameBySeason"
    ),
    _comment,
    N(
      "Gets the resort name column from the individual days table for the season specified by worksheet name."
    ),
    _result,
    Switch(
      LOWER(pSeasonName),
      LOWER("2025-2026"),
      tbl_2025_2026_Days[Resort Name],
      LOWER("2026-2027"),
      tbl_2026_2027_Days[Resort Name],
      LOWER("2027-2028"),
      tbl_2027_2028_Days[Resort Name],
      LOWER("2028-2029"),
      tbl_2028_2029_Days[Resort Name],
      LOWER("2029-2030"),
      tbl_2029_2030_Days[Resort Name],
      "Table Not Found",
    ),
    _result
  )
)